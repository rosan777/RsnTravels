{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "rosan777/rsntravel",
    "type": "project",
    "description": "RsnTravel - travel agency and hotel booking demo (Laravel).",
    "keywords": ["laravel", "travel", "hotel", "demo"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.12"
    },
    "conflict": {
        "symfony/clock": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/css-selector": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/mailer": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/translation": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "guzzlehttp/guzzle": ">=8.0",
        "guzzlehttp/promises": ">=3.0",
        "guzzlehttp/psr7": ">=3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan seed:demo"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.8"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
