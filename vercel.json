{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 120
        }
    },
    "routes": [
        {"src": "/(favicon\\.ico|robots\\.txt|img/.*)", "dest": "/public/$1"},
        {"src": "/(.*)", "dest": "/api/index.php"}
    ]
}
