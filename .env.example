APP_NAME=TravelDemo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# local: sqlite file in database/database.sqlite
# live: DB_CONNECTION=pgsql and DB_URL=<your Neon connection string>
DB_CONNECTION=sqlite
# DB_URL=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# live only: opening /setup-demo/<SETUP_TOKEN> runs migrate + seed:demo
SETUP_TOKEN=

# optional, later: real AI text for the trip planner (works without it)
ANTHROPIC_API_KEY=
